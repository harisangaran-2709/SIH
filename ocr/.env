# ===========================================================
# OCR Module - Environment Variables
# Copy this file to .env and adjust as needed.
# ===========================================================

# -------------------------------------------------------
# Python OCR service URL  (Node.js connects here)
# -------------------------------------------------------
OCR_SERVICE_URL=http://localhost:8000

# -------------------------------------------------------
# Node.js API port
# -------------------------------------------------------
PORT=3000

# -------------------------------------------------------
# PaddleOCR settings  (used by the Python service)
# -------------------------------------------------------

# OCR language.  Currently only 'en' is validated.
# See README for adding Indian language support.
OCR_LANG=en

# Confidence threshold.  Detections below this value are
# still returned but flagged as below_threshold=true.
OCR_CONFIDENCE_THRESHOLD=0.30

# Maximum upload size in megabytes (enforced by both layers)
OCR_MAX_IMAGE_SIZE_MB=10

# Port the Python OCR service listens on
OCR_PORT=8000

# Detector internal limit (px).  Larger = slower but more detail on tiny text.
OCR_DET_LIMIT_SIDE_LEN=960

# Set to 1 to use GPU (requires paddlepaddle-gpu build)
OCR_USE_GPU=0

# Set to 0 to disable angle classifier (slightly faster, worse on rotated text)
OCR_USE_ANGLE_CLS=1

# Per-image processing timeout in seconds (Python service)
OCR_TIMEOUT_SECONDS=60
