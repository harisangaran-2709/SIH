@echo off
REM ============================================================
REM OCR Module - Quick Start Script (Windows)
REM ============================================================

echo.
echo ????????????????????????????????????????????????????????
echo ?   OCR Module - Packaged Commodity Text Detection    ?
echo ????????????????????????????????????????????????????????
echo.

REM Check Python
python --version >nul 2>&1
if errorlevel 1 (
    echo ? Python is not installed or not in PATH
    pause
    exit /b 1
)

REM Check Node.js
node --version >nul 2>&1
if errorlevel 1 (
    echo ? Node.js is not installed or not in PATH
    pause
    exit /b 1
)

echo ? Python found
echo ? Node.js found
echo.

REM Check PaddleOCR
python -c "import paddleocr; print('? PaddleOCR', paddleocr.__version__)" 2>nul
if errorlevel 1 (
    echo ? PaddleOCR not installed
    echo Run: pip install -r service/requirements.txt
    pause
    exit /b 1
)

REM Check Node modules
if not exist "node_modules" (
    echo ? Node.js dependencies not installed
    echo Run: npm install
    pause
    exit /b 1
)
echo ? Node modules found
echo.

echo ???????????????????????????????????????????????????????
echo Starting services...
echo ???????????????????????????????????????????????????????
echo.

echo [1/2] Starting Python OCR service (port 8000)...
start "Python OCR Service" python -m service.app

timeout /t 8 /nobreak >nul

echo [2/2] Starting Node.js API (port 3000)...
start "Node.js API" npm start

timeout /t 3 /nobreak >nul

echo.
echo ???????????????????????????????????????????????????????
echo ? Services started!
echo ???????????????????????????????????????????????????????
echo.
echo ?? Testing page  : http://localhost:3000
echo ?? OCR endpoint  : POST http://localhost:3000/api/ocr
echo ?? Health check  : http://localhost:3000/api/ocr/health
echo.
echo Press any key to open the testing page in your browser...
pause >nul
start http://localhost:3000
